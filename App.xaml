<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:Popote.Converters"
             x:Class="Popote.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Système maison (docs/design-system.md) : jetons, couleurs, styles par usage. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Tokens.xaml" />
                <ResourceDictionary Source="Resources/Styles/AppColors.xaml" />
                <ResourceDictionary Source="Resources/Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters globaux -->
            <conv:HasTextConverter x:Key="HasText" />
            <conv:InvertBoolConverter x:Key="Not" />
            <conv:PhotoThumbConverter x:Key="PhotoThumb" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

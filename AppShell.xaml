<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Popote.Views"
       xmlns:res="clr-namespace:Popote.Resources.Strings"
       x:Class="Popote.AppShell">

    <!-- Onglets en bas : rendu maison sous Android (PopoteShellRenderer). -->
    <TabBar>
        <ShellContent Title="{x:Static res:AppResources.Tab_Recipes}" Icon="tab_recipes.png"
                      ContentTemplate="{DataTemplate views:RecipeListPage}"
                      Route="RecipeListPage" />
        <ShellContent Title="{x:Static res:AppResources.Tab_Week}" Icon="tab_week.png"
                      ContentTemplate="{DataTemplate views:PlanningPage}"
                      Route="PlanningPage" />
        <ShellContent Title="{x:Static res:AppResources.Tab_Shopping}" Icon="tab_shop.png"
                      ContentTemplate="{DataTemplate views:ShoppingListPage}"
                      Route="ShoppingListPage" />
    </TabBar>

</Shell>

<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Popote.Views"
       x:Class="Popote.AppShell">

    <!-- Onglets en bas : deux sections principales de l'app. -->
    <TabBar>
        <ShellContent Title="Recettes"
                      ContentTemplate="{DataTemplate views:RecipeListPage}"
                      Route="RecipeListPage" />
        <ShellContent Title="Courses"
                      ContentTemplate="{DataTemplate views:ShoppingListPage}"
                      Route="ShoppingListPage" />
    </TabBar>

</Shell>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Popote.ViewModels"
             xmlns:services="clr-namespace:Popote.Services"
             x:Class="Popote.Views.RecipeEditPage"
             x:DataType="vm:RecipeEditViewModel"
             x:Name="EditPage"
             Title="Recette">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="Titre" Style="{StaticResource SubtitleLabel}" />
            <Entry Text="{Binding Title}"
                   Placeholder="Ex : Curry de pois chiches" />

            <Label Text="Photo" Style="{StaticResource SubtitleLabel}" />
            <Border IsVisible="{Binding PhotoPath, Converter={StaticResource HasText}}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="180">
                <Image Source="{Binding PhotoPath}" Aspect="AspectFill" />
            </Border>
            <HorizontalStackLayout Spacing="8">
                <Button Text="Galerie" Style="{StaticResource ChipButton}" Command="{Binding PickPhotoCommand}" />
                <Button Text="Appareil photo" Style="{StaticResource ChipButton}" Command="{Binding TakePhotoCommand}" />
                <Button Text="Retirer" Style="{StaticResource ChipButton}"
                        Command="{Binding RemovePhotoCommand}"
                        IsVisible="{Binding PhotoPath, Converter={StaticResource HasText}}" />
            </HorizontalStackLayout>

            <Label Text="Portions" Style="{StaticResource SubtitleLabel}" />
            <HorizontalStackLayout Spacing="12">
                <Stepper Minimum="1" Maximum="20" Increment="1"
                         Value="{Binding Servings}" />
                <Label Text="{Binding Servings, StringFormat='{0} portions'}"
                       Style="{StaticResource BodyLabel}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label Text="Les quantités d'ingrédients ci-dessous sont pour ce nombre de portions. Pas besoin d'être exact — au détail, on pourra multiplier la recette."
                   Style="{StaticResource CaptionLabel}" />

            <Label Text="Ingrédients" Style="{StaticResource SubtitleLabel}" />
            <!-- Liste éditable : une ligne = nom + quantité + unité + bouton supprimer.
                 BindableLayout suffit (peu de lignes, pas besoin de virtualisation). -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Ingredients}" Spacing="14">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:IngredientLineViewModel">
                        <VerticalStackLayout Spacing="6">
                            <!-- Rangée 1 : nom + supprimer -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <Entry Grid.Column="0" Text="{Binding Name}" Placeholder="Ingrédient" />
                                <!-- La ligne ne connaît pas le VM de page : on vise sa commande
                                     via x:Reference, et on passe la ligne en paramètre. -->
                                <Button Grid.Column="1" Text="✕"
                                        WidthRequest="40" HeightRequest="40"
                                        BackgroundColor="Transparent" FontSize="16"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                        Command="{Binding BindingContext.RemoveIngredientCommand, Source={x:Reference EditPage}}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                            <!-- Rangée 2 : quantité + unité + rayon -->
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6">
                                <Entry Grid.Column="0" Text="{Binding QuantityText}"
                                       Placeholder="Qté" Keyboard="Numeric" WidthRequest="64" />
                                <Picker Grid.Column="1" Title="Unité"
                                        ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}"
                                        WidthRequest="104" />
                                <Picker Grid.Column="2" Title="Rayon"
                                        ItemsSource="{Binding Aisles}" SelectedItem="{Binding Aisle}" />
                            </Grid>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Button Text="Ajouter un ingrédient"
                    Command="{Binding AddIngredientCommand}" />

            <!-- Suggestions du catalogue : tap pour ajouter une ligne pré-remplie -->
            <VerticalStackLayout Spacing="6" IsVisible="{Binding HasKnownIngredients}">
                <Label Text="Déjà utilisés (tap pour ajouter)" Style="{StaticResource CaptionLabel}" />
                <FlexLayout BindableLayout.ItemsSource="{Binding KnownIngredients}" Wrap="Wrap" Direction="Row">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="services:IngredientCatalogItem">
                            <Border Style="{StaticResource Chip}" Margin="0,0,8,8" FlexLayout.Shrink="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.AddKnownIngredientCommand, Source={x:Reference EditPage}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Name}" Style="{StaticResource ChipLabel}" LineBreakMode="NoWrap" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <Label Text="Préparation" Style="{StaticResource SubtitleLabel}" />
            <Editor Text="{Binding Instructions}"
                    Placeholder="Décris les étapes..."
                    AutoSize="TextChanges"
                    HeightRequest="180" />

            <Button Text="Enregistrer"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}"
                    Margin="0,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

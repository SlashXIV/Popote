<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Popote.ViewModels"
             xmlns:services="clr-namespace:Popote.Services"
             xmlns:controls="clr-namespace:Popote.Controls"
             xmlns:res="clr-namespace:Popote.Resources.Strings"
             x:Class="Popote.Views.RecipeEditPage"
             Shell.PresentationMode="NotAnimated"
             x:DataType="vm:RecipeEditViewModel"
             x:Name="EditPage"
             Title="{Binding PageTitle}">

    <!-- Saisie : aucune animation, le clavier et le focus restent ceux du système. -->
    <Grid RowDefinitions="Auto,*">
        <controls:PageHeader Title="{Binding PageTitle}" ShowBack="True">
            <controls:IconButton Glyph="IconCheck" IconRole="Accent" Command="{Binding SaveCommand}"
                                 Description="{x:Static res:AppResources.Edit_Save}" />
        </controls:PageHeader>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource Space24}">

                <!-- Import par IA : le presse-papiers fait le lien, ce formulaire sert d'aperçu -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="{StaticResource Space8}">
                        <Label Text="{x:Static res:AppResources.Import_CardTitle}" Style="{StaticResource BodyStrong}"
                               SemanticProperties.HeadingLevel="Level2" />
                        <Label Text="{x:Static res:AppResources.Import_Step1}" Style="{StaticResource Caption}" />
                        <Button Text="{x:Static res:AppResources.Import_Copy}" Style="{StaticResource CompactButton}"
                                HorizontalOptions="Start" Command="{Binding CopyAiInstructionsCommand}" />
                        <Label Text="{x:Static res:AppResources.Import_Step2}" Style="{StaticResource Caption}" />
                        <Button Text="{x:Static res:AppResources.Import_Paste}" Style="{StaticResource CompactButton}"
                                HorizontalOptions="Start" Command="{Binding PasteAiAnswerCommand}" />
                        <Label Text="{Binding ImportReport}" Style="{StaticResource Body}"
                               IsVisible="{Binding ImportReport, Converter={StaticResource HasText}}" />
                    </VerticalStackLayout>
                </Border>

                <controls:Field Label="{x:Static res:AppResources.Edit_FieldTitle}" Error="{Binding TitleError}">
                    <Entry Text="{Binding Title}" Placeholder="{x:Static res:AppResources.Edit_TitlePlaceholder}" />
                </controls:Field>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space12}">
                        <VerticalStackLayout VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False">
                            <Label Text="{x:Static res:AppResources.Edit_Favorite}" Style="{StaticResource BodyStrong}" />
                            <Label Text="{x:Static res:AppResources.Edit_FavoriteHelp}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <controls:ToggleSwitch Grid.Column="1" IsToggled="{Binding IsFavorite}"
                                              Description="{x:Static res:AppResources.Edit_Favorite}" />
                    </Grid>
                </Border>

                <!-- Photo -->
                <VerticalStackLayout Spacing="{StaticResource Space8}">
                    <Label Text="{x:Static res:AppResources.Edit_Photo}" Style="{StaticResource Eyebrow}" />
                    <Border IsVisible="{Binding PhotoPath, Converter={StaticResource HasText}}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 16"
                            HeightRequest="{StaticResource PhotoEditHeight}">
                        <Image Source="{Binding PhotoPath}" Aspect="AspectFill" AutomationProperties.IsInAccessibleTree="False" />
                    </Border>
                    <HorizontalStackLayout Spacing="{StaticResource Space8}">
                        <Button Text="{x:Static res:AppResources.Edit_PhotoGallery}" Style="{StaticResource CompactButton}" Command="{Binding PickPhotoCommand}" />
                        <Button Text="{x:Static res:AppResources.Edit_PhotoCamera}" Style="{StaticResource CompactButton}" Command="{Binding TakePhotoCommand}" />
                        <Button Text="{x:Static res:AppResources.Edit_PhotoRemove}" Style="{StaticResource QuietButton}"
                                Command="{Binding RemovePhotoCommand}"
                                IsVisible="{Binding PhotoPath, Converter={StaticResource HasText}}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Portions de base et temps -->
                <VerticalStackLayout Spacing="{StaticResource Space8}">
                    <Label Text="{x:Static res:AppResources.Edit_Portions}" Style="{StaticResource Eyebrow}" />
                    <controls:PortionStepper Value="{Binding Servings}" Maximum="20" />
                    <Label Text="{x:Static res:AppResources.Edit_PortionsHelp}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space12}">
                    <controls:Field Label="{x:Static res:AppResources.Edit_Prep}" Suffix="{x:Static res:AppResources.Unit_Minutes}">
                        <Entry Text="{Binding PrepMinutesText}" Keyboard="Numeric" />
                    </controls:Field>
                    <controls:Field Grid.Column="1" Label="{x:Static res:AppResources.Edit_Cook}" Suffix="{x:Static res:AppResources.Unit_Minutes}">
                        <Entry Text="{Binding CookMinutesText}" Keyboard="Numeric" />
                    </controls:Field>
                </Grid>

                <!-- Ingrédients : une carte par ligne (nom, quantité, unité, rayon) -->
                <VerticalStackLayout Spacing="{StaticResource Space12}">
                    <Label Text="{x:Static res:AppResources.Edit_Ingredients}" Style="{StaticResource Heading}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Ingredients}" Spacing="{StaticResource Space12}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:IngredientLineViewModel">
                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="{StaticResource Space8}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space4}">
                                            <controls:Field>
                                                <Entry Text="{Binding Name}" Placeholder="{x:Static res:AppResources.Edit_IngredientName}" />
                                            </controls:Field>
                                            <controls:IconButton Grid.Column="1" Glyph="IconTrash" IconRole="Mute"
                                                                 Description="{x:Static res:AppResources.Edit_RemoveIngredient}"
                                                                 Command="{Binding BindingContext.RemoveIngredientCommand, Source={x:Reference EditPage}}"
                                                                 CommandParameter="{Binding .}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,2*" ColumnSpacing="{StaticResource Space8}">
                                            <controls:Field>
                                                <Entry Text="{Binding QuantityText}" Keyboard="Numeric"
                                                       Placeholder="{x:Static res:AppResources.Edit_Quantity}" />
                                            </controls:Field>
                                            <controls:Field Grid.Column="1" ShowChevron="True">
                                                <Picker Title="{x:Static res:AppResources.Edit_Unit}"
                                                        ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" />
                                            </controls:Field>
                                        </Grid>
                                        <controls:Field ShowChevron="True">
                                            <controls:Field.Leading>
                                                <controls:Bowl Aisle="{Binding Aisle}" Size="{StaticResource Bowl}" />
                                            </controls:Field.Leading>
                                            <Picker Title="{x:Static res:AppResources.Edit_Aisle}"
                                                    ItemsSource="{Binding Aisles}" SelectedItem="{Binding Aisle}" />
                                        </controls:Field>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="{x:Static res:AppResources.Edit_AddIngredient}" Style="{StaticResource QuietButton}"
                            Command="{Binding AddIngredientCommand}" />

                    <!-- Suggestions du catalogue : toucher ajoute une ligne pré-remplie -->
                    <VerticalStackLayout Spacing="{StaticResource Space8}" IsVisible="{Binding HasKnownIngredients}">
                        <Label Text="{x:Static res:AppResources.Edit_Known}" Style="{StaticResource Caption}" />
                        <FlexLayout BindableLayout.ItemsSource="{Binding KnownIngredients}" Wrap="Wrap" Direction="Row">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="services:IngredientCatalogItem">
                                    <Button Text="{Binding Name}" Style="{StaticResource ChipAction}" Margin="{StaticResource ChipMargin}"
                                            FlexLayout.Shrink="0"
                                            Command="{Binding BindingContext.AddKnownIngredientCommand, Source={x:Reference EditPage}}"
                                            CommandParameter="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Tags -->
                <VerticalStackLayout Spacing="{StaticResource Space8}">
                    <Label Text="{x:Static res:AppResources.Edit_Tags}" Style="{StaticResource Heading}" />
                    <FlexLayout BindableLayout.ItemsSource="{Binding Tags}" Wrap="Wrap" Direction="Row">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TagToggleViewModel">
                                <controls:ToggleChip Text="{Binding Name}" IsSelected="{Binding IsSelected}" Margin="{StaticResource ChipMarginRow}"
                                                     FlexLayout.Shrink="0"
                                                     Command="{Binding BindingContext.ToggleTagCommand, Source={x:Reference EditPage}}"
                                                     CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space8}">
                        <controls:Field>
                            <Entry Text="{Binding NewTagText}" Placeholder="{x:Static res:AppResources.Edit_NewTag}"
                                   ReturnCommand="{Binding AddNewTagCommand}" />
                        </controls:Field>
                        <Button Grid.Column="1" Text="{x:Static res:AppResources.Edit_AddTag}" Style="{StaticResource CompactButton}"
                                Command="{Binding AddNewTagCommand}" />
                    </Grid>
                </VerticalStackLayout>

                <controls:Field Label="{x:Static res:AppResources.Edit_Steps}">
                    <Editor Text="{Binding Instructions}" Placeholder="{x:Static res:AppResources.Edit_StepsPlaceholder}" />
                </controls:Field>

                <controls:Field Label="{x:Static res:AppResources.Edit_Notes}">
                    <Editor Text="{Binding Notes}" Placeholder="{x:Static res:AppResources.Edit_NotesPlaceholder}" />
                </controls:Field>

                <Grid>
                    <Button Text="{x:Static res:AppResources.Edit_Save}" Command="{Binding SaveCommand}"
                            IsVisible="{Binding IsSaved, Converter={StaticResource Not}}" />
                    <Border x:Name="SavedBadge" IsVisible="{Binding IsSaved}" StrokeThickness="0"
                            MinimumHeightRequest="{StaticResource ButtonHeight}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource HighlightLight}, Dark={StaticResource HighlightDark}}"
                            SemanticProperties.Description="{x:Static res:AppResources.Edit_Saved}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource RadiusButton}" />
                        </Border.StrokeShape>
                        <controls:Icon Glyph="IconCheck" Role="OnHighlight" StrokeThickness="3" />
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Popote.ViewModels"
             xmlns:controls="clr-namespace:Popote.Controls"
             xmlns:res="clr-namespace:Popote.Resources.Strings"
             x:Class="Popote.Views.ShoppingListPage"
             x:DataType="vm:ShoppingListViewModel"
             x:Name="Page"
             Title="{x:Static res:AppResources.Shopping_Title}">

    <Grid RowDefinitions="Auto,*">
        <controls:PageHeader Title="{x:Static res:AppResources.Shopping_Title}" Eyebrow="{Binding RemainingLabel}">
            <controls:IconButton Glyph="IconRecipes" Command="{Binding ToggleRecipePickerCommand}"
                                 Description="{x:Static res:AppResources.Shopping_FromRecipes}" />
            <controls:IconButton Glyph="IconTrash" Command="{Binding ClearCommand}" IsVisible="{Binding HasItems}"
                                 Description="{x:Static res:AppResources.Shopping_Clear}" />
        </controls:PageHeader>

        <!-- Articles groupés par rayon : cocher = remplir le bol -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding ShoppingList}" IsGrouped="True" SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout Padding="{StaticResource GutterBand}" Spacing="{StaticResource Space12}">

                    <!-- À partir de recettes (repliable) -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding IsPickingRecipes}">
                        <VerticalStackLayout Spacing="{StaticResource Space8}">
                            <Label Text="{x:Static res:AppResources.Shopping_FromRecipes}" Style="{StaticResource Heading}" />
                            <Label Text="{x:Static res:AppResources.Shopping_FromRecipesHelp}" Style="{StaticResource Caption}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Recipes}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SelectableRecipeViewModel">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space8}">
                                            <controls:BowlCheck IsChecked="{Binding IsSelected}" UseAccent="True"
                                                                Description="{Binding Title}" />
                                            <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Body}"
                                                   VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                                <BindableLayout.EmptyView>
                                    <Label Text="{x:Static res:AppResources.Shopping_NoRecipes}" Style="{StaticResource Caption}" />
                                </BindableLayout.EmptyView>
                            </VerticalStackLayout>
                            <Button Text="{x:Static res:AppResources.Shopping_Generate}" Command="{Binding GenerateCommand}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Ajout d'un article à la main -->
                    <controls:Field>
                        <controls:Field.Leading>
                            <controls:Icon Glyph="IconPlus" Size="{StaticResource IconSmall}" Role="Mute" />
                        </controls:Field.Leading>
                        <Entry Text="{Binding NewItemText}" ReturnCommand="{Binding AddManualItemCommand}"
                               Placeholder="{x:Static res:AppResources.Shopping_AddPlaceholder}" />
                    </controls:Field>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:ShoppingAisle">
                    <HorizontalStackLayout Spacing="{StaticResource Space8}" Padding="{StaticResource AisleHeaderPadding}">
                        <controls:Bowl Aisle="{Binding Aisle}" Size="{StaticResource Bowl}" />
                        <Label Text="{Binding Aisle}" Style="{StaticResource Eyebrow}" VerticalOptions="Center"
                               SemanticProperties.HeadingLevel="Level2"
                               TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                    </HorizontalStackLayout>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ShoppingItemViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource Space4}" Padding="{StaticResource ItemPadding}">
                        <controls:BowlCheck IsChecked="{Binding IsChecked}" Aisle="{Binding Aisle}"
                                            Description="{Binding Spoken}" />
                        <Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Body}"
                               VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsChecked}" Value="True">
                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MuteLight}, Dark={StaticResource MuteDark}}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <controls:NumberLabel Grid.Column="2" Text="{Binding QuantityLabel}" Style="{StaticResource QuantityMute}"
                                              VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                        <controls:IconButton Grid.Column="3" Glyph="IconClose" IconRole="Mute"
                                             Description="{Binding Name, StringFormat={x:Static res:AppResources.Shopping_RemoveItem}}"
                                             Command="{Binding BindingContext.RemoveItemCommand, Source={x:Reference Page}}"
                                             CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="{StaticResource EmptyPadding}" Spacing="{StaticResource Space12}">
                    <controls:Bowl UseAccent="True" State="Empty" Size="{StaticResource BowlEmptyState}" />
                    <Label Text="{x:Static res:AppResources.Shopping_Empty}" Style="{StaticResource Heading}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{x:Static res:AppResources.Shopping_EmptyHint}" Style="{StaticResource Caption}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Popote.ViewModels"
             xmlns:services="clr-namespace:Popote.Services"
             xmlns:conv="clr-namespace:Popote.Converters"
             x:Class="Popote.Views.ShoppingListPage"
             x:DataType="vm:ShoppingListViewModel"
             Title="Liste de courses">

    <ContentPage.Resources>
        <conv:AisleToColorConverter x:Key="AisleToColor" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto,*" Padding="16" RowSpacing="12">

        <!-- Sélection des recettes -->
        <Label Grid.Row="0" Text="Choisis des recettes" Style="{StaticResource SubtitleLabel}" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Recipes}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SelectableRecipeViewModel">
                    <Grid ColumnDefinitions="Auto,*" Padding="0,4" ColumnSpacing="8">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                  Color="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                        <Label Grid.Column="1" Text="{Binding Title}"
                               Style="{StaticResource BodyLabel}" VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="Aucune recette à sélectionner." Style="{StaticResource CaptionLabel}" Margin="0,8" />
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Génération -->
        <Button Grid.Row="2" Text="Générer la liste"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding GenerateCommand}" Margin="0,4" />

        <!-- Résultat -->
        <Label Grid.Row="3" Text="Liste de courses" Style="{StaticResource SubtitleLabel}"
               IsVisible="{Binding HasGenerated}" />

        <CollectionView Grid.Row="4" ItemsSource="{Binding ShoppingList}" IsGrouped="True">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:ShoppingAisle">
                    <HorizontalStackLayout Spacing="8" Padding="4,10,4,4">
                        <Border WidthRequest="12" HeightRequest="12" StrokeThickness="0"
                                VerticalOptions="Center" StrokeShape="RoundRectangle 6"
                                BackgroundColor="{Binding Aisle, Converter={StaticResource AisleToColor}}" />
                        <Label Text="{Binding Aisle}" Style="{StaticResource SubtitleLabel}" />
                    </HorizontalStackLayout>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ShoppingItemViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="4,2,16,2" ColumnSpacing="8">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" VerticalOptions="Center"
                                  Color="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                        <Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource BodyLabel}" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsChecked}" Value="True">
                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                    <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Grid.Column="2" Text="{Binding QuantityLabel}" Style="{StaticResource CaptionLabel}" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsChecked}" Value="True">
                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                    <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="Coche des recettes puis « Générer la liste »."
                       Style="{StaticResource CaptionLabel}"
                       HorizontalOptions="Center" Margin="24" />
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>

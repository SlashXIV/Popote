<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Popote.ViewModels"
             x:Class="Popote.Views.ShoppingListPage"
             x:DataType="vm:ShoppingListViewModel"
             x:Name="Page"
             Title="Liste de courses">

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,*" Padding="16" RowSpacing="12">

        <!-- Sélection des recettes -->
        <Label Grid.Row="0" Text="Choisis des recettes" Style="{StaticResource SubtitleLabel}" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Recipes}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SelectableRecipeViewModel">
                    <Grid ColumnDefinitions="Auto,*" Padding="0,4" ColumnSpacing="8">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                  Color="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                        <Label Grid.Column="1" Text="{Binding Title}"
                               Style="{StaticResource BodyLabel}" VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="Aucune recette à sélectionner." Style="{StaticResource CaptionLabel}" Margin="0,8" />
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Génération -->
        <Button Grid.Row="2" Text="Générer la liste"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding GenerateCommand}" Margin="0,4" />

        <!-- Ajout d'un article à la main -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Grid.Column="0" Text="{Binding NewItemText}" Placeholder="Ajouter un article (ex : sopalin)"
                   ReturnCommand="{Binding AddManualItemCommand}" />
            <Button Grid.Column="1" Text="Ajouter" Style="{StaticResource ChipButton}"
                    Command="{Binding AddManualItemCommand}" />
        </Grid>

        <!-- En-tête liste + vider -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" IsVisible="{Binding HasItems}">
            <Label Grid.Column="0" Text="Liste de courses" Style="{StaticResource SubtitleLabel}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Vider" Style="{StaticResource ChipButton}" Command="{Binding ClearCommand}" />
        </Grid>

        <!-- Articles (groupés par rayon, cochables, persistés) -->
        <CollectionView Grid.Row="5" ItemsSource="{Binding ShoppingList}" IsGrouped="True">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:ShoppingAisle">
                    <HorizontalStackLayout Spacing="8" Padding="4,10,4,4">
                        <Border WidthRequest="12" HeightRequest="12" StrokeThickness="0"
                                VerticalOptions="Center" StrokeShape="RoundRectangle 6"
                                BackgroundColor="{Binding Aisle, Converter={StaticResource AisleToColor}}" />
                        <Label Text="{Binding Aisle}" Style="{StaticResource SubtitleLabel}" />
                    </HorizontalStackLayout>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ShoppingItemViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="4,2" ColumnSpacing="8">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" VerticalOptions="Center"
                                  Color="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                        <Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource BodyLabel}" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsChecked}" Value="True">
                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                    <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Grid.Column="2" Text="{Binding QuantityLabel}" Style="{StaticResource CaptionLabel}" VerticalOptions="Center" />
                        <Button Grid.Column="3" Text="✕" WidthRequest="36" HeightRequest="36"
                                BackgroundColor="Transparent" FontSize="14"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                Command="{Binding BindingContext.RemoveItemCommand, Source={x:Reference Page}}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="Coche des recettes puis « Générer », ou ajoute un article à la main."
                       Style="{StaticResource CaptionLabel}"
                       HorizontalOptions="Center" Margin="24" />
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>

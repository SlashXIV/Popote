<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Popote.ViewModels"
             xmlns:controls="clr-namespace:Popote.Controls"
             xmlns:res="clr-namespace:Popote.Resources.Strings"
             x:Class="Popote.Views.RecipeDetailPage"
             x:DataType="vm:RecipeDetailViewModel"
             Title="{Binding Title}">

    <Grid>
        <ScrollView x:Name="Scroller">
            <VerticalStackLayout Spacing="{StaticResource Space24}" Padding="{StaticResource ScrollEnd}">

                <!-- Photo en pleine largeur ; sans photo, un simple espace sous la barre d'actions -->
                <Image x:Name="Hero" Source="{Binding PhotoPath}" Aspect="AspectFill"
                       HeightRequest="{StaticResource HeroHeight}" IsVisible="{Binding HasPhoto}"
                       AutomationProperties.IsInAccessibleTree="False" />
                <BoxView HeightRequest="{StaticResource TouchTarget}" Color="Transparent"
                         IsVisible="{Binding HasPhoto, Converter={StaticResource Not}}" />

                <VerticalStackLayout x:Name="Body" Padding="{StaticResource Gutter}" Spacing="{StaticResource Space24}">

                    <VerticalStackLayout Spacing="{StaticResource Space12}">
                        <Label x:Name="TitleLabel" Text="{Binding Title}" Style="{StaticResource Poster}"
                               SemanticProperties.HeadingLevel="Level1" />
                        <FlexLayout BindableLayout.ItemsSource="{Binding Tags}" Wrap="Wrap" Direction="Row"
                                    AlignItems="Center" IsVisible="{Binding HasTags}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Style="{StaticResource Chip}" Margin="{StaticResource ChipMargin}" FlexLayout.Shrink="0">
                                        <Label Text="{Binding .}" Style="{StaticResource ChipLabel}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <controls:NumberLabel Text="{Binding TimesLabel}" Style="{StaticResource Caption}"
                                              IsVisible="{Binding HasTimes}" />
                    </VerticalStackLayout>

                    <Button Text="{x:Static res:AppResources.Detail_Cook_Action}"
                            Command="{Binding GoToCookingModeCommand}" />

                    <!-- Portions : réglage fin + multiplicateurs, recalcule les quantités -->
                    <VerticalStackLayout Spacing="{StaticResource Space8}">
                        <controls:PortionStepper Value="{Binding TargetServings}" Caption="{Binding BaseServingsLabel}" />
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="{StaticResource Space8}"
                              SemanticProperties.Description="{x:Static res:AppResources.Detail_Multiplier}">
                            <Button Text="{x:Static res:AppResources.Multiplier_Half}" Style="{StaticResource CompactButton}"
                                    SemanticProperties.Description="{x:Static res:AppResources.Multiplier_HalfSpoken}"
                                    Command="{Binding MultiplyCommand}" CommandParameter="0.5" />
                            <Button Grid.Column="1" Text="{x:Static res:AppResources.Multiplier_One}" Style="{StaticResource CompactButton}"
                                    SemanticProperties.Description="{x:Static res:AppResources.Multiplier_OneSpoken}"
                                    Command="{Binding MultiplyCommand}" CommandParameter="1" />
                            <Button Grid.Column="2" Text="{x:Static res:AppResources.Multiplier_Two}" Style="{StaticResource CompactButton}"
                                    SemanticProperties.Description="{x:Static res:AppResources.Multiplier_TwoSpoken}"
                                    Command="{Binding MultiplyCommand}" CommandParameter="2" />
                            <Button Grid.Column="3" Text="{x:Static res:AppResources.Multiplier_Three}" Style="{StaticResource CompactButton}"
                                    SemanticProperties.Description="{x:Static res:AppResources.Multiplier_ThreeSpoken}"
                                    Command="{Binding MultiplyCommand}" CommandParameter="3" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Mise en place : un bol par ingrédient, sur le plan de travail -->
                    <VerticalStackLayout Spacing="{StaticResource Space8}">
                        <Label Text="{x:Static res:AppResources.Detail_MiseEnPlace}" Style="{StaticResource Heading}" />
                        <Border Style="{StaticResource Worktop}">
                            <VerticalStackLayout>
                                <BoxView Style="{StaticResource WorktopEdge}" />
                                <VerticalStackLayout x:Name="Ingredients" Padding="{StaticResource WorktopPadding}"
                                                     BindableLayout.ItemsSource="{Binding Ingredients}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ScaledIngredient">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space12}"
                                                  MinimumHeightRequest="{StaticResource TouchTarget}" Padding="{StaticResource RowPadding}"
                                                  SemanticProperties.Description="{Binding Spoken}">
                                                <controls:Bowl Aisle="{Binding Aisle}" Size="{StaticResource Bowl}" />
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center"
                                                                     AutomationProperties.IsInAccessibleTree="False">
                                                    <Label Text="{Binding Name}" Style="{StaticResource BodyStrong}" />
                                                    <Label Text="{Binding Aisle}" Style="{StaticResource Caption}" />
                                                </VerticalStackLayout>
                                                <controls:NumberLabel Grid.Column="2" Text="{Binding QuantityLabel}" Style="{StaticResource Quantity}"
                                                                      VerticalOptions="Center" HorizontalTextAlignment="End"
                                                                      AutomationProperties.IsInAccessibleTree="False" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Préparation : étapes numérotées (une recette est une séquence) -->
                    <VerticalStackLayout Spacing="{StaticResource Space12}">
                        <Label Text="{x:Static res:AppResources.Detail_Steps}" Style="{StaticResource Heading}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Steps}" Spacing="{StaticResource Space16}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:StepLine">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space12}"
                                          SemanticProperties.Description="{Binding Spoken}">
                                        <Border WidthRequest="{StaticResource StepBadge}" HeightRequest="{StaticResource StepBadge}" StrokeThickness="2" VerticalOptions="Start"
                                                StrokeShape="RoundRectangle 999"
                                                Stroke="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                                                AutomationProperties.IsInAccessibleTree="False">
                                            <controls:NumberLabel Text="{Binding Number}" FontFamily="Bricolage" FontSize="{StaticResource StepBadgeText}"
                                                                  HorizontalOptions="Center" VerticalOptions="Center"
                                                                  TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Body}"
                                               VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="{StaticResource Space8}" IsVisible="{Binding HasNotes}">
                        <Label Text="{x:Static res:AppResources.Detail_Notes}" Style="{StaticResource Heading}" />
                        <Label Text="{Binding Notes}" Style="{StaticResource Body}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Barre d'actions flottante, sur pastilles (lisible sur la photo) -->
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="{StaticResource Space4}"
              Padding="{StaticResource FloatingBarPadding}" VerticalOptions="Start">
            <controls:IconButton Glyph="IconBack" Look="OnPhoto" Description="{x:Static res:AppResources.Action_Back}"
                                 Command="{Binding GoBackCommand}" />
            <controls:IconButton Grid.Column="2" Glyph="IconStar" Look="OnPhoto" IconRole="Favorite"
                                 Filled="{Binding IsFavorite}" Description="{Binding FavoriteActionText}"
                                 Command="{Binding ToggleFavoriteCommand}" />
            <controls:IconButton Grid.Column="3" Glyph="IconShare" Look="OnPhoto"
                                 Description="{x:Static res:AppResources.Detail_Share}" Command="{Binding ShareCommand}" />
            <controls:IconButton Grid.Column="4" Glyph="IconEdit" Look="OnPhoto"
                                 Description="{x:Static res:AppResources.Detail_Edit}" Command="{Binding GoToEditCommand}" />
        </Grid>
    </Grid>
</ContentPage>

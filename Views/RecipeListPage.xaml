<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RecettesApp.ViewModels"
             xmlns:models="clr-namespace:RecettesApp.Models"
             x:Class="RecettesApp.Views.RecipeListPage"
             x:DataType="vm:RecipeListViewModel"
             x:Name="Page"
             Title="Mes recettes">

    <!-- Bouton "Ajouter" dans la barre du haut -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Ajouter" Command="{Binding GoToEditCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="12" RowSpacing="8">

        <!-- Barre de recherche : déclenche LoadCommand à la validation -->
        <SearchBar Grid.Row="0"
                   Placeholder="Rechercher une recette..."
                   Text="{Binding SearchText}"
                   SearchCommand="{Binding LoadCommand}" />

        <!-- Pull-to-refresh -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadCommand}">

            <CollectionView ItemsSource="{Binding Recipes}" SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Recipe">
                        <Border Padding="12" Margin="0,4"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1">
                            <!-- Tap sur la carte = éditer cette recette.
                                 On vise la commande du ViewModel de la page via x:Reference,
                                 car ici le BindingContext local est une Recipe, pas le VM. -->
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.GoToEditCommand, Source={x:Reference Page}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Title}"
                                       FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding Servings, StringFormat='{0} portions'}"
                                       FontSize="13" Opacity="0.7" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="Aucune recette. Appuie sur Ajouter pour commencer."
                           HorizontalOptions="Center" Margin="24" Opacity="0.6" />
                </CollectionView.EmptyView>

            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>

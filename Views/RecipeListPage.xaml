<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Popote.ViewModels"
             xmlns:models="clr-namespace:Popote.Models"
             x:Class="Popote.Views.RecipeListPage"
             x:DataType="vm:RecipeListViewModel"
             x:Name="Page"
             Title="Mes recettes">

    <!-- Bouton "Ajouter" dans la barre du haut -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Ajouter" Command="{Binding GoToEditCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <!-- Barre de recherche : déclenche LoadCommand à la validation -->
        <SearchBar Grid.Row="0"
                   Placeholder="Rechercher une recette..."
                   Text="{Binding SearchText}"
                   SearchCommand="{Binding LoadCommand}" />

        <!-- Pull-to-refresh -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadCommand}">

            <CollectionView ItemsSource="{Binding Recipes}" SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Recipe">
                        <Border Style="{StaticResource CardBorder}" Margin="0,4">
                            <!-- Tap sur la carte = éditer cette recette.
                                 On vise la commande du ViewModel de la page via x:Reference,
                                 car ici le BindingContext local est une Recipe, pas le VM. -->
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.GoToDetailCommand, Source={x:Reference Page}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Grid.Column="0"
                                        IsVisible="{Binding PhotoPath, Converter={StaticResource HasText}}"
                                        WidthRequest="56" HeightRequest="56" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                                    <Image Source="{Binding PhotoPath}" Aspect="AspectFill" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" Style="{StaticResource SubtitleLabel}" />
                                    <Label Text="{Binding Servings, StringFormat='{0} portions'}"
                                           Style="{StaticResource CaptionLabel}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="Aucune recette. Appuie sur Ajouter pour commencer."
                           Style="{StaticResource CaptionLabel}"
                           HorizontalOptions="Center" Margin="24" />
                </CollectionView.EmptyView>

            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Popote.ViewModels"
             xmlns:models="clr-namespace:Popote.Models;assembly=Popote.Data"
             x:Class="Popote.Views.RecipeListPage"
             x:DataType="vm:RecipeListViewModel"
             x:Name="Page"
             Title="Mes recettes">

    <!-- Bouton "Ajouter" dans la barre du haut -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cuisiner" Command="{Binding GoToCookWithCommand}" />
        <ToolbarItem Text="Ajouter" Command="{Binding GoToEditCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">

        <!-- Barre de recherche : déclenche LoadCommand à la validation -->
        <SearchBar Grid.Row="0"
                   Placeholder="Rechercher une recette..."
                   Text="{Binding SearchText}"
                   SearchCommand="{Binding LoadCommand}" />

        <!-- Filtre par tags (défilement horizontal) -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                    IsVisible="{Binding HasTags}">
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding FilterTags}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:TagToggleViewModel">
                        <Border StrokeThickness="0" Padding="12,6" StrokeShape="RoundRectangle 999"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryContainerLight}, Dark={StaticResource PrimaryContainerDark}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.ToggleFilterCommand, Source={x:Reference Page}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Name}" FontFamily="InterMedium" FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Pull-to-refresh -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadCommand}">

            <CollectionView ItemsSource="{Binding Recipes}" SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Recipe">
                        <!-- Balayer vers la gauche = supprimer (avec confirmation). -->
                        <SwipeView Margin="0,4">
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Supprimer"
                                               BackgroundColor="{StaticResource PaletteBrick}"
                                               Command="{Binding BindingContext.DeleteRecipeCommand, Source={x:Reference Page}}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Style="{StaticResource CardBorder}">
                                <!-- Tap sur la carte = ouvrir le détail.
                                     On vise la commande du ViewModel de la page via x:Reference,
                                     car ici le BindingContext local est une Recipe, pas le VM. -->
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.GoToDetailCommand, Source={x:Reference Page}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Grid.Column="0"
                                        IsVisible="{Binding PhotoPath, Converter={StaticResource HasText}}"
                                        WidthRequest="56" HeightRequest="56" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                                    <Image Source="{Binding PhotoPath}" Aspect="AspectFill" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="★" Style="{StaticResource SubtitleLabel}"
                                               IsVisible="{Binding IsFavorite}"
                                               TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                        <Label Text="{Binding Title}" Style="{StaticResource SubtitleLabel}" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Servings, StringFormat='{0} portions'}"
                                           Style="{StaticResource CaptionLabel}" />
                                </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="Aucune recette. Appuie sur Ajouter pour commencer."
                           Style="{StaticResource CaptionLabel}"
                           HorizontalOptions="Center" Margin="24" />
                </CollectionView.EmptyView>

            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>

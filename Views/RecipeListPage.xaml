<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Popote.ViewModels"
             xmlns:models="clr-namespace:Popote.Models;assembly=Popote.Data"
             xmlns:controls="clr-namespace:Popote.Controls"
             xmlns:conv="clr-namespace:Popote.Converters"
             xmlns:res="clr-namespace:Popote.Resources.Strings"
             x:Class="Popote.Views.RecipeListPage"
             x:DataType="vm:RecipeListViewModel"
             x:Name="Page"
             Title="{x:Static res:AppResources.Tab_Recipes}">

    <ContentPage.Resources>
        <conv:RecipeCardConverter x:Key="RecipeCard" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <controls:PageHeader Title="{x:Static res:AppResources.Tab_Recipes}"
                             Eyebrow="{x:Static res:AppResources.App_Name}">
            <controls:IconButton Glyph="IconPot" Command="{Binding GoToCookWithCommand}"
                                 Description="{x:Static res:AppResources.Action_CookWith}" />
            <controls:IconButton Glyph="IconPlus" Command="{Binding GoToEditCommand}"
                                 Description="{x:Static res:AppResources.Action_AddRecipe}" />
            <controls:IconButton Glyph="IconGear" Command="{Binding GoToSettingsCommand}"
                                 Description="{x:Static res:AppResources.Settings_Title}" />
        </controls:PageHeader>

        <!-- Recherche (validée au clavier) -->
        <controls:Field Grid.Row="1" Margin="{StaticResource GutterBand}">
            <controls:Field.Leading>
                <controls:Icon Glyph="IconSearch" Size="{StaticResource IconSmall}" Role="Mute" />
            </controls:Field.Leading>
            <Entry Text="{Binding SearchText}" ReturnType="Search" ReturnCommand="{Binding LoadCommand}"
                   Placeholder="{x:Static res:AppResources.List_SearchPlaceholder}" />
        </controls:Field>

        <!-- Tri + filtres par tags (défilement horizontal) -->
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="{StaticResource Space8}" Padding="{StaticResource GutterBand}">
                <controls:Field ShowChevron="True" MinimumWidthRequest="{StaticResource SortMinWidth}">
                    <Picker ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex}"
                            Title="{x:Static res:AppResources.List_Sort}" />
                </controls:Field>
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding FilterTags}" Spacing="{StaticResource Space8}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:TagToggleViewModel">
                            <controls:ToggleChip Text="{Binding Name}" IsSelected="{Binding IsSelected}"
                                                 Command="{Binding BindingContext.ToggleFilterCommand, Source={x:Reference Page}}"
                                                 CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </ScrollView>

        <RefreshView Grid.Row="3" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Recipes}" SelectionMode="None">
                <CollectionView.Header>
                    <BoxView HeightRequest="{StaticResource Space4}" Color="Transparent" />
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Recipe">
                        <!-- Balayer vers la gauche = supprimer (avec confirmation). -->
                        <SwipeView Margin="{StaticResource ListCardMargin}">
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="{x:Static res:AppResources.Action_Delete}"
                                               Command="{Binding BindingContext.DeleteRecipeCommand, Source={x:Reference Page}}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Style="{StaticResource Card}" Padding="{StaticResource CardPadding}"
                                    SemanticProperties.Description="{Binding ., Converter={StaticResource RecipeCard}, ConverterParameter=a11y}"
                                    SemanticProperties.Hint="{x:Static res:AppResources.List_OpenHint}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.GoToDetailCommand, Source={x:Reference Page}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space12}"
                                      AutomationProperties.IsInAccessibleTree="False">
                                    <!-- Photo, ou plan de travail avec un bol quand il n'y en a pas -->
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                            WidthRequest="{StaticResource Thumb}" HeightRequest="{StaticResource Thumb}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource WorktopLight}, Dark={StaticResource WorktopDark}}">
                                        <Grid>
                                            <controls:Bowl UseAccent="True" Size="{StaticResource BowlLarge}" State="Placed" />
                                            <Image Source="{Binding PhotoPath, Converter={StaticResource PhotoThumb}}" Aspect="AspectFill"
                                                   IsVisible="{Binding PhotoPath, Converter={StaticResource HasText}}" />
                                        </Grid>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource Space4}" VerticalOptions="Center">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource TightSpacing}">
                                            <controls:Icon Glyph="IconStar" Filled="True" Role="Favorite" Size="{StaticResource IconTiny}"
                                                           VerticalOptions="Start" Margin="{StaticResource StarNudge}"
                                                           IsVisible="{Binding IsFavorite}" />
                                            <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource CardTitle}"
                                                   LineBreakMode="WordWrap" MaxLines="3" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <controls:NumberLabel Text="{Binding ., Converter={StaticResource RecipeCard}, ConverterParameter=meta}"
                                                                  Style="{StaticResource Caption}" />
                                            <HorizontalStackLayout Grid.Column="1" Spacing="{StaticResource BowlGap}"
                                                                   BindableLayout.ItemsSource="{Binding ., Converter={StaticResource RecipeCard}, ConverterParameter=aisles}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <controls:Bowl Aisle="{Binding .}" Size="{StaticResource BowlSmall}" />
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- État vide : une invitation à agir, jamais un écran muet -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="{StaticResource EmptyPadding}" Spacing="{StaticResource Space12}" VerticalOptions="Center">
                        <controls:Bowl UseAccent="True" State="Empty" Size="{StaticResource BowlEmptyState}" />
                        <Label Text="{x:Static res:AppResources.List_Empty}" Style="{StaticResource Heading}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{x:Static res:AppResources.List_EmptyHint}" Style="{StaticResource Caption}"
                               HorizontalTextAlignment="Center" />
                        <Button Text="{x:Static res:AppResources.Action_AddRecipe}" Command="{Binding GoToEditCommand}"
                                HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Popote.ViewModels"
             x:Class="Popote.Views.CookingModePage"
             x:DataType="vm:CookingModeViewModel"
             Title="Mode cuisson">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="16" RowSpacing="12">

        <Label Grid.Row="0" Text="{Binding Title}" Style="{StaticResource TitleLabel}" />

        <!-- Étapes défilables -->
        <CarouselView Grid.Row="1" ItemsSource="{Binding Steps}" IndicatorView="indicator" Loop="False">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="vm:StepLine">
                    <Border Style="{StaticResource CardBorder}" Margin="4">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="16">
                            <Label Text="{Binding Number, StringFormat='Étape {0}'}"
                                   Style="{StaticResource SubtitleLabel}" HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                            <Label Text="{Binding Text}" Style="{StaticResource TitleLabel}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <IndicatorView Grid.Row="2" x:Name="indicator" HorizontalOptions="Center"
                       IndicatorColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                       SelectedIndicatorColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />

        <!-- Minuteur -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" Text="{Binding TimerMinutes}" Keyboard="Numeric" Placeholder="minuteur (min)" />
                    <Button Grid.Column="1" Text="Démarrer" Style="{StaticResource ChipButton}"
                            Command="{Binding StartTimerCommand}" />
                    <Button Grid.Column="2" Text="Arrêter" Style="{StaticResource ChipButton}"
                            Command="{Binding StopTimerCommand}" IsVisible="{Binding IsTimerRunning}" />
                </Grid>
                <Label Text="{Binding TimerDisplay}" Style="{StaticResource DisplayLabel}"
                       HorizontalOptions="Center"
                       IsVisible="{Binding TimerDisplay, Converter={StaticResource HasText}}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Popote.ViewModels"
             xmlns:models="clr-namespace:Popote.Models;assembly=Popote.Data"
             xmlns:controls="clr-namespace:Popote.Controls"
             xmlns:res="clr-namespace:Popote.Resources.Strings"
             x:Class="Popote.Views.PlanningPage"
             x:DataType="vm:PlanningViewModel"
             x:Name="Page"
             Title="{x:Static res:AppResources.Week_Title}">

    <Grid RowDefinitions="Auto,*">
        <controls:PageHeader Title="{x:Static res:AppResources.Week_Title}" Eyebrow="{Binding WeekLabel}">
            <controls:IconButton Glyph="IconBack" Command="{Binding PreviousWeekCommand}"
                                 Description="{x:Static res:AppResources.Week_Previous}" />
            <controls:IconButton Glyph="IconForward" Command="{Binding NextWeekCommand}"
                                 Description="{x:Static res:AppResources.Week_Next}" />
        </controls:PageHeader>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource Space16}">

                <!-- Un jour = une rangée du plan de travail ; un repas posé = un bol plein -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Days}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlanningDayViewModel">
                            <VerticalStackLayout>
                                <Grid ColumnSpacing="{StaticResource Space12}" Padding="{StaticResource DayPadding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource DayColumn}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <VerticalStackLayout SemanticProperties.Description="{Binding Label}"
                                                         SemanticProperties.HeadingLevel="Level2">
                                        <Label Text="{Binding DayName}" Style="{StaticResource Eyebrow}"
                                               AutomationProperties.IsInAccessibleTree="False" />
                                        <controls:NumberLabel Text="{Binding DayNumber}" Style="{StaticResource Title}"
                                                              AutomationProperties.IsInAccessibleTree="False">
                                            <controls:NumberLabel.Triggers>
                                                <DataTrigger TargetType="controls:NumberLabel" Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                                </DataTrigger>
                                            </controls:NumberLabel.Triggers>
                                        </controls:NumberLabel>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Meals}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:PlannedMeal">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space8}">
                                                        <controls:Bowl UseAccent="True" State="Full" Size="{StaticResource BowlProgress}" />
                                                        <Label Grid.Column="1" Text="{Binding Recipe.Title}" Style="{StaticResource BodyStrong}"
                                                               VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                                        <controls:IconButton Grid.Column="2" Glyph="IconClose" IconRole="Mute"
                                                                             Description="{Binding Recipe.Title, StringFormat={x:Static res:AppResources.Week_RemoveMeal}}"
                                                                             Command="{Binding BindingContext.RemoveMealCommand, Source={x:Reference Page}}"
                                                                             CommandParameter="{Binding .}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                        <Button Text="{x:Static res:AppResources.Week_AddMeal}" Style="{StaticResource QuietButton}"
                                                HorizontalOptions="Start" BorderWidth="0" Padding="0"
                                                SemanticProperties.Description="{Binding Label, StringFormat={x:Static res:AppResources.Week_AddMealTo}}"
                                                Command="{Binding BindingContext.AddMealCommand, Source={x:Reference Page}}"
                                                CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>
                                </Grid>
                                <BoxView Style="{StaticResource Rule}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Button Text="{x:Static res:AppResources.Week_Shopping}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding GenerateShoppingListCommand}" />

                <!-- Courses de la semaine (aperçu, non persistant) -->
                <VerticalStackLayout IsVisible="{Binding HasShoppingList}" Spacing="{StaticResource Space8}">
                    <Label Text="{x:Static res:AppResources.Week_ShoppingTitle}" Style="{StaticResource Heading}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ShoppingList}" Spacing="{StaticResource Space8}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ShoppingAisle">
                                <VerticalStackLayout>
                                    <HorizontalStackLayout Spacing="{StaticResource Space8}" Padding="{StaticResource SectionTop}">
                                        <controls:Bowl Aisle="{Binding Aisle}" Size="{StaticResource Bowl}" />
                                        <Label Text="{Binding Aisle}" Style="{StaticResource Eyebrow}" VerticalOptions="Center"
                                               SemanticProperties.HeadingLevel="Level2" />
                                    </HorizontalStackLayout>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding .}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ShoppingItemViewModel">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space4}">
                                                    <controls:BowlCheck IsChecked="{Binding IsChecked}" Aisle="{Binding Aisle}"
                                                                        Description="{Binding Spoken}" />
                                                    <Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Body}"
                                                           VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsChecked}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MuteLight}, Dark={StaticResource MuteDark}}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                    <controls:NumberLabel Grid.Column="2" Text="{Binding QuantityLabel}" Style="{StaticResource QuantityMute}"
                                                                          VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

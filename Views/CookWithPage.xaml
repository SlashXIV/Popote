<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Popote.ViewModels"
             xmlns:models="clr-namespace:Popote.Models;assembly=Popote.Data"
             xmlns:controls="clr-namespace:Popote.Controls"
             xmlns:conv="clr-namespace:Popote.Converters"
             xmlns:res="clr-namespace:Popote.Resources.Strings"
             x:Class="Popote.Views.CookWithPage"
             Shell.PresentationMode="NotAnimated"
             x:DataType="vm:CookWithViewModel"
             x:Name="Page"
             Title="{x:Static res:AppResources.CookWith_Title}">

    <ContentPage.Resources>
        <conv:RecipeCardConverter x:Key="RecipeCard" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <controls:PageHeader Title="{x:Static res:AppResources.CookWith_Title}" ShowBack="True" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource Space16}">
                <Label Text="{x:Static res:AppResources.CookWith_Help}" Style="{StaticResource Caption}" />

                <!-- Ingrédients du catalogue, rangés par rayon -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups}" Spacing="{StaticResource Space12}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AisleToggleGroup">
                            <VerticalStackLayout Spacing="{StaticResource Space4}">
                                <HorizontalStackLayout Spacing="{StaticResource Space8}">
                                    <controls:Bowl Aisle="{Binding Aisle}" Size="{StaticResource Bowl}" />
                                    <Label Text="{Binding Aisle}" Style="{StaticResource Eyebrow}" VerticalOptions="Center"
                                               SemanticProperties.HeadingLevel="Level2" />
                                </HorizontalStackLayout>
                                <FlexLayout BindableLayout.ItemsSource="{Binding Items}" Wrap="Wrap" Direction="Row">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TagToggleViewModel">
                                            <controls:ToggleChip Text="{Binding Name}" IsSelected="{Binding IsSelected}" Margin="{StaticResource ChipMarginRow}"
                                                                 FlexLayout.Shrink="0"
                                                                 Command="{Binding BindingContext.ToggleCommand, Source={x:Reference Page}}"
                                                                 CommandParameter="{Binding .}" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <BoxView Style="{StaticResource Rule}" />

                <!-- Résultats -->
                <Label Text="{x:Static res:AppResources.CookWith_Results}" Style="{StaticResource Heading}"
                       IsVisible="{Binding HasSelection}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Results}" Spacing="{StaticResource Space8}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Recipe">
                            <Border Style="{StaticResource Card}"
                                    SemanticProperties.Description="{Binding ., Converter={StaticResource RecipeCard}, ConverterParameter=a11y}"
                                    SemanticProperties.Hint="{x:Static res:AppResources.List_OpenHint}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.GoToDetailCommand, Source={x:Reference Page}}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="{StaticResource Space4}" AutomationProperties.IsInAccessibleTree="False">
                                    <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                    <controls:NumberLabel Text="{Binding ., Converter={StaticResource RecipeCard}, ConverterParameter=meta}"
                                                          Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                    <BindableLayout.EmptyView>
                        <Label Style="{StaticResource Caption}" HorizontalTextAlignment="Center"
                               Text="{Binding EmptyMessage}" />
                    </BindableLayout.EmptyView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

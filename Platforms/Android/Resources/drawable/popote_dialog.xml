<?xml version="1.0" encoding="utf-8"?>
<!-- Fond des fenêtres natives : carte Surface aux coins de 16 (RadiusCard), marges du dialogue Material. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="24dp" android:insetRight="24dp"
    android:insetTop="24dp" android:insetBottom="24dp">
    <shape android:shape="rectangle">
        <corners android:radius="16dp" />
        <solid android:color="@color/popote_surface" />
    </shape>
</inset>

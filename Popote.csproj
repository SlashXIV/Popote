<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android uniquement pour l'instant (cf. non-objectifs de la ROADMAP). -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Popote</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Génération du XAML à la compilation (bindings compilés, build plus rapide). -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Nom affiché -->
		<ApplicationTitle>Popote</ApplicationTitle>

		<!-- Identifiant de l'app -->
		<ApplicationId>onl.nci.popote</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.4.0</ApplicationDisplayVersion>
		<ApplicationVersion>4</ApplicationVersion>

		<SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- Signature de l'APK Release. Les mots de passe NE sont PAS ici :
	     ils se passent au build (-p:AndroidSigningKeyPass=… -p:AndroidSigningStorePass=…). -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>popote.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>popote</AndroidSigningKeyAlias>
		<!-- Pas de trimming : EF Core s'appuie sur la réflexion. -->
		<AndroidLinkMode>None</AndroidLinkMode>
		<!-- Pas d'AOT : il exige le trimming (XA1030) ; sans trimming, les images AOT
		     font planter l'app au démarrage (assertion Mono class-init, vu sur téléphone
		     et émulateur avec le SDK .NET 10.0.3xx). Code JIT, démarrage un peu plus lent. -->
		<RunAOTCompilation>false</RunAOTCompilation>
	</PropertyGroup>

	<ItemGroup>
		<!-- Icône de l'app -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#4B1F45" />

		<!-- Écran de démarrage -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#4B1F45" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Polices -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Textes de l'interface (français, langue de référence) : classe AppResources générée
		     par MSBuild à la compilation, utilisée en XAML via x:Static et en C#. -->
		<EmbeddedResource Update="Resources\Strings\AppResources.resx">
			<Generator>MSBuild:Compile</Generator>
			<StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
			<StronglyTypedNamespace>Popote.Resources.Strings</StronglyTypedNamespace>
			<StronglyTypedClassName>AppResources</StronglyTypedClassName>
			<StronglyTypedFileName>$(IntermediateOutputPath)AppResources.Designer.cs</StronglyTypedFileName>
			<PublicClass>true</PublicClass>
		</EmbeddedResource>

		<!-- Ressources brutes -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.9" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
	</ItemGroup>

	<!-- Couche données (entités + EF Core + migrations) dans une bibliothèque à part. -->
	<ItemGroup>
		<ProjectReference Include="Popote.Data\Popote.Data.csproj" />
	</ItemGroup>

	<!-- La lib est dans un sous-dossier : on l'exclut de la compilation de l'app
	     (sinon ses .cs seraient compilés deux fois). -->
	<ItemGroup>
		<Compile Remove="Popote.Data\**\*.cs" />
		<None Remove="Popote.Data\**" />
		<Compile Remove="Popote.Tests\**\*.cs" />
		<None Remove="Popote.Tests\**" />
	</ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android uniquement pour l'instant (cf. non-objectifs de la ROADMAP). -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Popote</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Génération du XAML à la compilation (bindings compilés, build plus rapide). -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Nom affiché -->
		<ApplicationTitle>Popote</ApplicationTitle>

		<!-- Identifiant de l'app -->
		<ApplicationId>onl.nci.popote</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- Icône de l'app -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#8CB369" />

		<!-- Écran de démarrage -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F7F4EE" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Polices -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Ressources brutes -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.9" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
	</ItemGroup>

	<!-- Couche données (entités + EF Core + migrations) dans une bibliothèque à part. -->
	<ItemGroup>
		<ProjectReference Include="Popote.Data\Popote.Data.csproj" />
	</ItemGroup>

	<!-- La lib est dans un sous-dossier : on l'exclut de la compilation de l'app
	     (sinon ses .cs seraient compilés deux fois). -->
	<ItemGroup>
		<Compile Remove="Popote.Data\**\*.cs" />
		<None Remove="Popote.Data\**" />
	</ItemGroup>

</Project>
